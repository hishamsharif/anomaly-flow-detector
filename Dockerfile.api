FROM python:3.12-slim

ARG TORCH_BUILD_TYPE=cpu

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Upgrade to CUDA torch when requested (adds ~2 GB; only done on explicit opt-in)
RUN if [ "$TORCH_BUILD_TYPE" = "cu121" ]; then \
    pip install --no-cache-dir torch==2.5.1 \
        --index-url https://download.pytorch.org/whl/cu121; \
    fi

COPY . .

RUN mkdir -p data models logs

EXPOSE 8000
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port 8000 2>&1 | tee /app/logs/api.log"]
