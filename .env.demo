# Copy this file to .env and customise as needed.
# .env is gitignored; .env.demo is committed as a reference.
# All 21 configurable fields are listed here (required first, optional below).

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/afd.db

# ── Paths ────────────────────────────────────────────────────────────────────
BUNDLED_DATASET_DIR=data/CIC-IDS2017
MODEL_ARTIFACT_DIR=artifacts

# Host path to the CIC-IDS2017 CSV directory (Docker only).
# Set if your dataset lives outside the project to avoid symlink issues.
# Leave unset to use ./data/CIC-IDS2017.
# CIC_IDS2017_DIR=/home/user/datasets/cic-ids-2017

# Google Drive file ID for CIC-IDS2017 (~225 MB zip) — used by `make setup`
CICIDS2017_GDRIVE_FILE_ID=10UG7eEAUI8kV4_CMFsrK-5nVz4Bm0Ey3

# ── Device ───────────────────────────────────────────────────────────────────
# "auto" resolves at startup via torch.cuda.is_available()
DEVICE=auto

# ── AE fine-tune ─────────────────────────────────────────────────────────────
# FINE_TUNE_K_THRESHOLD=50          # min analyst feedbacks to trigger fine-tune
# AE_ANOMALY_THRESHOLD_PERCENTILE=95.0  # percentile of val-benign MSE used for threshold
# AE_REPLAY_BUFFER_FRACTION=0.10    # fraction of benign val set replayed during fine-tune
# AE_FREEZE_EPOCHS=5                # epochs to freeze encoder before full fine-tune

# ── AE detector — outlier clipping ───────────────────────────────────────────
# CIC-IDS2017 has features with extreme outliers (e.g. Flow Bytes/s) that reach
# 100k+ sigma after StandardScaler, inflating AE threshold to unusable values.
# Clip at ±N sigma to prevent val-benign outliers from contaminating calibration.
# AE_OUTLIER_CLIP_SIGMA=5.0

# ── Regression gates ─────────────────────────────────────────────────────────
# FAR_GATE_MAX=0.05     # max false-alarm rate before fine-tune is blocked
# RECALL_GATE_MAX=0.05  # max recall drop before fine-tune is blocked

# ── Feature engineering ───────────────────────────────────────────────────────
# SMOTE_MAX_PER_CLASS=50000         # cap synthetic samples per minority class
# VARIANCE_THRESHOLD=0.0            # drop features with variance ≤ this value
# CORRELATION_THRESHOLD=0.95        # drop one of any pair with |r| ≥ this value
# FEATURE_SELECTION_K=0             # top-K features to keep (0 = keep all)
# FEATURE_SELECTION_METHOD=mi       # "mi" (mutual info) or "chi2"

# ── Inference ────────────────────────────────────────────────────────────────
# CLF_CONFIDENCE_THRESHOLD=0.5      # min XGBoost confidence to report KNOWN_ATTACK
# MAX_UPLOAD_MB=100                 # max CSV upload size
# SYNC_MAX_ROWS=5000                # max rows returned per sync/export request

# ── API ───────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost"]
LOG_LEVEL=INFO
