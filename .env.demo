# Copy this file to .env and customise as needed.
# .env is gitignored; .env.demo is committed as a reference.

DATABASE_URL=sqlite+aiosqlite:///./data/afd.db
BUNDLED_DATASET_DIR=data/CIC-IDS2017

# Host path to the CIC-IDS2017 CSV directory, used by Docker only.
# Set this if your dataset lives outside the project (e.g. an archive copy)
# so the container mounts it directly instead of relying on symlinks.
# Example: CIC_IDS2017_DIR=/home/user/datasets/cic-ids-2017
# Leave unset to use the default ./data/CIC-IDS2017 folder.
# CIC_IDS2017_DIR=
# Google Drive file ID for CIC-IDS2017 (~225 MB zip) — used by `make dataset`
CICIDS2017_GDRIVE_FILE_ID=10UG7eEAUI8kV4_CMFsrK-5nVz4Bm0Ey3
MODEL_ARTIFACT_DIR=models
DEVICE=auto
LOG_LEVEL=INFO

# FINE_TUNE_K_THRESHOLD=50
# CLF_CONFIDENCE_THRESHOLD=0.5
# SYNC_MAX_ROWS=5000
# MAX_UPLOAD_MB=100
